# Copy to /etc/kylin-node-executor.env and set strict permissions:
#   sudo install -m 0600 -o kylin-agent -g kylin-agent kylin-node-executor.env.example /etc/kylin-node-executor.env
# Then edit and fill in the real shared token. NEVER commit the real token.

KYLIN_ENROLLMENT_TOKEN=replace-with-bootstrap-token
# 注意：审批令牌的任何签名材料都**不配置在这里**（ADR-002 §3.4）。
# 令牌由控制面以 SM2 私钥签发；验签公钥只属于特权助手，
# 放在 /etc/kylin-privhelper/approval.pub（root 属主）。
# 若把私钥配在本文件里，非特权的 Agent 进程就持有了签发能力——攻陷 Agent 即可为
# 任意工具自签合法审批令牌，人工审批便不再构成边界。
KYLIN_GRPC_ENROLL_ADDRESS=127.0.0.1:9091
KYLIN_GRPC_CONTROL_ADDRESS=127.0.0.1:9090
KYLIN_NODE_EXECUTOR_CERT_DIR=/var/lib/kylin-node-executor/certs

# enroll 阶段必须钉住平台身份，否则 Agent **拒绝注册**（fail-closed，刻意行为）。
# 原因：此刻节点还没有任何证书，它要交出 bootstrap token、并把对端返回的 CA 存成后续
# mTLS 的信任锚。这一步不校验对端，中间人就能一次拿到 token 再把自己的 CA 塞进来，
# 之后所有 mTLS 都在攻击者的信任域里"正常工作"，没有任何后续环节能发现。
# 下面三个变量必须至少配置一个（前两个可同时配，链校验与指纹钉扎会同时生效）。
#
# 推荐：平台 CA 的 PEM 路径（取自后端 HOST_AGENT_GRPC_CERT_DIR/ca.crt）
KYLIN_ENROLL_CA_FILE=/etc/kylin-node-executor/platform-ca.crt
# 或：服务端叶子证书 DER 的 SHA-256（变量名里的 CA 是历史遗留），可带冒号、不分大小写
#   openssl s_client -connect <后端IP>:9091 </dev/null 2>/dev/null \
#     | openssl x509 -outform DER | openssl dgst -sha256
#KYLIN_ENROLL_CA_SHA256=
# 仅开发 / 演示：显式接受首次连接（InsecureSkipVerify），每次连接都会打 SECURITY WARNING。
# 生产禁用。取值不是 true 一律按未配置处理（即照样拒绝注册）。
#KYLIN_ENROLL_INSECURE_TOFU=true
# 服务端证书的 SNI / 校验名，默认 localhost；后端证书 CN/SAN 不是 localhost 时才需要改。
# enroll 与控制流可以分开设；控制流未设时回退到 enroll 名。
#KYLIN_ENROLL_SERVER_NAME=localhost
#KYLIN_CONTROL_SERVER_NAME=localhost

# Optional demo observability.
KYLIN_OTEL_ENABLED=false
OTEL_SERVICE_NAME=kylin-node-executor
OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
OTEL_EXPORTER_OTLP_INSECURE=true
