# 复制到 /etc/kylin-workspace-runner.env 并收紧权限：
#   sudo install -m 0640 -o root -g kylin-workspace \
#        kylin-workspace-runner.env.example /etc/kylin-workspace-runner.env
# unit 里用的是 EnvironmentFile=-/etc/kylin-workspace-runner.env（前置 "-"），
# 文件不存在也能启动，此时全部走 unit 内置的 Environment= 与代码默认值。
#
# 下面列出的是 internal/config/config.go 里**真实读取**的全部变量，一个不多一个不少。
# 注意 unit 文件里已经设了 SOCKET / ROOT / IMAGE / PEER_USER 四个；systemd 的规则是
# EnvironmentFile 先于 Environment= 加载，同名以 **Environment= 为准**，所以要改这四个
# 得改 unit（或用 drop-in），在本文件里改不生效。

# --- 与 node-executor 对接 ---
# 必须与 node-executor 的 KYLIN_WORKSPACE_RUNNER_SOCKET 指向同一路径。
KYLIN_WORKSPACE_SOCKET=/run/kylin-workspace/workspace.sock
# SO_PEERCRED 授权调用方：用户名或数字 uid。填 any 可关闭对端校验（仅开发用，会打警告）。
# 解析失败时进程启动即失败，不会静默放行。
KYLIN_WORKSPACE_PEER_USER=kylin-agent

# --- Podman 与镜像 ---
KYLIN_PODMAN_BINARY=podman
# 由 agents/workspace-runner/Containerfile 构建：podman build -t kylin-workspace:latest .
KYLIN_WORKSPACE_IMAGE=kylin-workspace:latest
# 工作区根目录：seccomp profile、审计日志默认都落在它下面。
KYLIN_WORKSPACE_ROOT=/var/lib/kylin-workspace

# --- 容量与配额 ---
KYLIN_WORKSPACE_MAX_CONTAINERS=32
KYLIN_WORKSPACE_CONTAINER_TIMEOUT_SEC=600
KYLIN_WORKSPACE_MEMORY_LIMIT_MB=512
KYLIN_WORKSPACE_PIDS_LIMIT=256
KYLIN_WORKSPACE_TMPFS_SIZE_MB=256
# 单次命令输出上限（字节），默认 1MiB。
KYLIN_WORKSPACE_MAX_OUTPUT_BYTES=1048576
KYLIN_WORKSPACE_COMMAND_TIMEOUT_SEC=300

# --- 路径校验（防穿越）---
KYLIN_WORKSPACE_MAX_PATH_DEPTH=16
KYLIN_WORKSPACE_MAX_FILE_NAME_LENGTH=255

# --- 生命周期 ---
# 启动时如何处置上次遗留的容器：cleanup（删）/ recreate（重建）/ keep（保留）。
KYLIN_WORKSPACE_RECOVERY_MODE=cleanup
# 每个工作区保留的快照镜像数上限。
KYLIN_WORKSPACE_SNAPSHOT_KEEP=5
KYLIN_WORKSPACE_SNAPSHOT_MAX_AGE_HOURS=72
# 工作区空闲多久后回收容器（秒）。
KYLIN_WORKSPACE_IDLE_TIMEOUT=1800

# --- 审计 ---
# 取值 1/true/yes/on 开，0/false/no/off 关；写不认识的值按默认（开）处理。
KYLIN_WORKSPACE_AUDIT_ENABLED=true
# 不设时默认是 ${KYLIN_WORKSPACE_ROOT}/audit/workspace-audit.ndjson。
KYLIN_WORKSPACE_AUDIT_LOG=/var/lib/kylin-workspace/audit/workspace-audit.ndjson
