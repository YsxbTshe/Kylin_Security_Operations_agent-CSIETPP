# Node
**/node_modules/
**/dist/

# Java
**/target/
*.class

# Go
*.exe
*.test
*.out
**/.gocache/
**/.gocache-*/
**/*.go.[0-9]*
vendor/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Docker 栈的审批签名密钥：只保留生成说明，密钥本体永不入库
# （deploy/docker/secrets/README.md 给出 openssl 生成步骤）
deploy/docker/secrets/*
!deploy/docker/secrets/README.md

# Local tooling
.tools/
.secrets/

# Local env files
deploy/config/*.env
!deploy/config/*.env.example
services/backend/.env
services/backend/.env.*
!services/backend/.env.example
!services/backend/.env.*.example
apps/admin-web/.env
apps/admin-web/.env.*
!apps/admin-web/.env.development
!apps/admin-web/.env.example
!apps/admin-web/.env.*.example
apps/dashboard-screen/.env
apps/dashboard-screen/.env.*
!apps/dashboard-screen/.env.development
!apps/dashboard-screen/.env.example
!apps/dashboard-screen/.env.*.example

# Local backend runtime data
services/backend/data/
__pycache__/

# Local VM images, cloud-init seeds and SSH keys (never commit)
vms/

# 提交包构建产物（由 scripts/build-submission.sh 生成，不入库）
build/

# 宣传片制作工程：分镜、抓帧、截图等中间件，且内含成片副本。
# 最终交付的 5 段成片与封面在 docs/08-决赛冲刺/promo-videos/ 下单独入库。
videos/
# 抓站工具留下的失败日志，不是项目产物
capture/
