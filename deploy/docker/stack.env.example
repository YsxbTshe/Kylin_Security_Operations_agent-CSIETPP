# 复制为 deploy/docker/.env（compose 只会自动读取与第一个 -f 同目录的 .env）：
#   cp stack.env.example .env
# 里面的默认值只够本机演示，对外演示前至少要改掉三个 token 和数据库口令。

# ---- 数据库 ----
POSTGRES_USER=kylinops
POSTGRES_PASSWORD=kylinops
POSTGRES_DB=kylinops
# 只绑 127.0.0.1，仅用于 psql 排查
POSTGRES_HOST_PORT=5434

# ---- 端口 ----
BACKEND_HTTP_PORT=8080
BACKEND_GRPC_CONTROL_PORT=9090
# ⚠️ 与 rag-services.yml 的 milvus 冲突，两栈同起时改这个
BACKEND_GRPC_ENROLL_PORT=9091
ADMIN_HTTP_PORT=18080
SCREEN_HTTP_PORT=18081

# ---- token（改掉！）----
# 节点注册引导 token，须与节点 /etc/kylin-node-executor.env 的 KYLIN_ENROLLMENT_TOKEN 相同
HOST_AGENT_SHARED_TOKEN=dev-host-agent-token
# 大屏 token；改这个之后 dashboard-screen 必须 --build 重建（Vite 构建期内联）
SCREEN_SHARED_TOKEN=dev-screen-token
SCREEN_ORGANIZATION_ID=org-alpha

# ---- 审批令牌 SM2 签名密钥 ----
# compose 里通过挂载目录 ./secrets -> /etc/kylinops/keys 提供，先生成密钥对：
#   mkdir -p deploy/docker/secrets && cd deploy/docker/secrets
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:SM2 -out approval-private.pem
#   openssl pkey -in approval-private.pem -pubout -out approval.pub
#   chmod 600 approval-private.pem
#   openssl asn1parse -in approval-private.pem | head   # 应看到 id-ecPublicKey
# 公钥还要下发到每个节点的 /etc/kylin-privhelper/approval.pub（root:root 0644），
# 且节点侧 KYLIN_PRIVHELPER_APPROVAL_KEY_ID 必须与下面这个 id 完全一致。
APPROVAL_SIGNING_KEY_ID=approval-1

# ---- 其他 ----
AGENT_RUNTIME_WORKER_ID=backend-1
STRICT_MODE_ENABLED=false
BACKEND_JAVA_OPTS=-XX:MaxRAMPercentage=70
# 反代可信网段，必须与 stack.yml 里 networks.default 的 subnet 一致
TRUSTED_PROXY_CIDRS=172.31.240.0/24
COMPOSE_SUBNET=172.31.240.0/24

# ---- 可观测栈（叠加 observability.yml 时生效）----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
