# Copy to deploy/config/prod.env and fill real values. Do not commit prod.env.
DEPLOY_SSH_TARGET='root@example.com'
DEPLOY_SSH_PORT='22'
DEPLOY_SSH_PASSWORD=''

BACKEND_REMOTE_JAR='/opt/kylinops/backend/backend.jar'
BACKEND_OWNER='kylinops:kylinops'
BACKEND_SERVICE='kylinops-backend'
BACKEND_HEALTH_URL='http://127.0.0.1:8080/api/v1/system/health'
BACKEND_START_TIMEOUT_SECONDS='90'

# Optional backend OpenTelemetry Java Agent deployment.
# If BACKEND_OTEL_ENABLED=true and BACKEND_OTEL_AGENT_LOCAL is set, deploy-prod.sh uploads the local agent jar.
# If BACKEND_OTEL_AGENT_LOCAL is empty, BACKEND_OTEL_AGENT_PATH must already exist on the remote host.
BACKEND_OTEL_ENABLED='false'
BACKEND_OTEL_AGENT_LOCAL=''
BACKEND_OTEL_AGENT_PATH='/opt/kylinops/otel/opentelemetry-javaagent.jar'
BACKEND_OTEL_SERVICE_NAME='kylinops-backend'
BACKEND_OTEL_EXPORTER_OTLP_ENDPOINT='http://127.0.0.1:4318'
BACKEND_OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
BACKEND_OTEL_RESOURCE_ATTRIBUTES='service.namespace=kylinops,deployment.environment=demo'

HOST_TASK_REDIS_EVENTS_ENABLED='true'
HOST_TASK_REDIS_HOST='127.0.0.1'
HOST_TASK_REDIS_PORT='6379'
HOST_TASK_ASSISTANT_EVENTS_STREAM='stream:assistant-events'
HOST_TASK_EVENTS_STREAM='stream:host-task-events'
HOST_TASK_APPROVAL_EVENTS_STREAM='stream:approval-events'

ADMIN_REMOTE_DIR='/opt/1panel/www/sites/kylinops-admin/index'
ADMIN_HEALTH_URL='http://127.0.0.1:18080/'

SCREEN_REMOTE_DIR='/opt/1panel/www/sites/kylinops-screen/index'
SCREEN_HEALTH_URL='http://127.0.0.1:18081/'
SCREEN_SHARED_TOKEN=''

# ---- 审批令牌签名（SM2-with-SM3 非对称）----
# 后端持私钥签发，节点侧特权助手持公钥验真——Agent 进程永不持有签发密钥。
# 旧的对称密钥变量 SAFEOPS_APPROVAL_TOKEN_SECRET 已随 ADR-002 废弃，后端零引用。
#
# 生成一对（PKCS#8 私钥 + PKIX 公钥）。必须用 genpkey，不要用
# `openssl ecparam -genkey -name SM2`：Ubuntu OpenSSL 3.0.2 会把算法 OID
# 写成 sm2，后端 BouncyCastle 解析失败，且失败发生在第一次审批签发。
#   bash deploy/scripts/generate-approval-keys.sh /etc/kylinops
# 或：
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:SM2 -out approval-private.pem
#   openssl pkey -in approval-private.pem -pubout -out approval.pub
# 自检：openssl asn1parse -in approval-private.pem | head 应看到 id-ecPublicKey。
#
# 路径已配置时后端启动即加载并试签；配错会直接起不来。三个变量都空时仍可启动
# （仅开发），但第一次审批会失败。
APPROVAL_SIGNING_KEY_ID='approval-1'
APPROVAL_SIGNING_PRIVATE_KEY_REF='/etc/kylinops/approval-private.pem'
APPROVAL_SIGNING_PUBLIC_KEY_REF='/etc/kylinops/approval.pub'

# 平台 gRPC 服务端证书 SAN。跨主机时改成控制面真实主机名/IP，节点侧同步设
# KYLIN_CONTROL_SERVER_NAME / KYLIN_ENROLL_SERVER_NAME。
HOST_AGENT_GRPC_SERVER_DNS_NAMES='localhost'
HOST_AGENT_GRPC_SERVER_IP_ADDRESSES='127.0.0.1'

# 节点侧：公钥落到特权助手，key id 必须与后端 APPROVAL_SIGNING_KEY_ID 一致。
# 路径 /etc/kylin-privhelper/approval.pub（root:root），由 KYLIN_PRIVHELPER_APPROVAL_PUB
# 与 KYLIN_PRIVHELPER_APPROVAL_KEY_ID 指定，**不是** Agent 的环境变量。
PRIVHELPER_APPROVAL_PUB_REMOTE='/etc/kylin-privhelper/approval.pub'

HOST_SSH_TARGET='vmuser@example.com'
HOST_SSH_PORT='60022'
HOST_SSH_PASSWORD=''
NODE_EXECUTOR_REMOTE_BIN='/opt/kylin-security-ops-agent/kylin-node-executor'
NODE_EXECUTOR_SERVICE='kylin-node-executor'
