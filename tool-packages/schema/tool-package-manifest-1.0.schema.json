{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kylinops.local/schemas/tool-package-manifest-1.0.json",
  "title": "Kylin ToolPackageManifest",
  "type": "object",
  "required": ["schemaVersion", "packageId", "version", "title", "description", "tools", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "packageId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$", "maxLength": 64 },
    "title": { "type": "string", "minLength": 1, "maxLength": 256 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tool" }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "jsonObjectSchema": {
      "type": "object",
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "properties": { "type": "object" },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "additionalProperties": { "const": false }
      },
      "additionalProperties": true
    },
    "resourceLock": {
      "type": "object",
      "required": ["template", "mode"],
      "properties": {
        "template": { "type": "string", "minLength": 1, "maxLength": 512 },
        "mode": { "enum": ["READ_SHARED", "WRITE_EXCLUSIVE"] }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "id", "version", "title", "description", "executor", "inputSchema", "outputSchema",
        "riskFloor", "readOnly", "alwaysRequireApproval", "directDisplay", "resourceLocks",
        "timeoutSeconds", "maxConcurrency", "idempotency", "reversibility", "nodeRequirements",
        "implementation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 192 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 256 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "executor": { "enum": ["RUNTIME", "WORKSPACE", "NODE", "CONNECTOR"] },
        "inputSchema": { "$ref": "#/$defs/jsonObjectSchema" },
        "outputSchema": { "$ref": "#/$defs/jsonObjectSchema" },
        "riskFloor": { "enum": ["R0", "R1", "R2", "R3", "R4", "R5"] },
        "readOnly": { "type": "boolean" },
        "alwaysRequireApproval": { "type": "boolean" },
        "directDisplay": { "type": "boolean" },
        "resourceLocks": { "type": "array", "items": { "$ref": "#/$defs/resourceLock" } },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "idempotency": {
          "type": "object",
          "required": ["type", "maxAttempts"],
          "properties": {
            "type": { "enum": ["IDEMPOTENT", "AT_MOST_ONCE", "NON_RETRYABLE"] },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 2 }
          },
          "additionalProperties": false
        },
        "reversibility": {
          "type": "object",
          "required": ["type", "description"],
          "properties": {
            "type": { "enum": ["NOT_APPLICABLE", "REVERSIBLE", "COMPENSATING", "IRREVERSIBLE"] },
            "description": { "type": "string", "minLength": 1, "maxLength": 1024 }
          },
          "additionalProperties": false
        },
        "nodeRequirements": {
          "type": "object",
          "required": ["commands"],
          "properties": {
            "commands": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9._+-]+$" }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "implementation": {
          "type": "object",
          "required": ["kind", "entrypoint", "digest"],
          "properties": {
            "kind": { "enum": ["NATIVE", "MCP_ADAPTER"] },
            "entrypoint": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
            "digest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "keyPurpose", "userId", "signedPayloadSm3", "derBase64"],
      "properties": {
        "algorithm": { "const": "SM2_WITH_SM3" },
        "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "keyPurpose": { "const": "catalog-signing-key" },
        "userId": { "const": "KYLIN-CATALOG-V1" },
        "signedPayloadSm3": { "$ref": "#/$defs/digest" },
        "derBase64": { "type": "string", "minLength": 8 }
      },
      "additionalProperties": false
    }
  }
}
